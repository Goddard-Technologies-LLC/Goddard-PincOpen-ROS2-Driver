<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="pinc_open_ros2_control" params="
                name
                prefix
                use_mock_hardware:=^|false
                default_color_rgba:='0 0 1. 1.'
                default_linkage_color_rgba:='0 0.5 1.0 1.0'
                default_tip_color_rgba:='0 0 1. 1.'
                baud_rate:='57600'
                serial_port:='/dev/pinc-gripper'
                error_timeout_ms:='500'
                dxl_id:='1'
                operating_mode:='3'"
  >
  <!-- ros2_control -->
  <ros2_control name="${prefix}ros2_control_hw_interface" type="system">
    <hardware>
      <xacro:if value="${use_mock_hardware}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="${use_mock_hardware}">
        <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
        <param name="port_name">${serial_port}</param>
        <param name="baud_rate">${baud_rate}</param>
        <param name="error_timeout_ms">${error_timeout_ms}</param>
        <param name="number_of_joints">1</param>
        <param name="number_of_transmissions">1</param>
        <param name="dynamixel_model_folder">/param/dxl_model</param>
        <param name="disable_torque_at_init">true</param>
      </xacro:unless>
    </hardware>

    <joint name="${prefix}gripper">
      <command_interface name="position">
        <param name="min">-2.653</param>
        <param name="max">0.1745</param>
      </command_interface>
      <xacro:if value="${use_mock_hardware}">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </xacro:if>
      <xacro:unless value="${use_mock_hardware}">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <!-- Dynamixel XM430-W210-R actuator (identity joint/transmission mapping) -->
    <xacro:unless value="${use_mock_hardware}">
      <gpio name="${prefix}dxl">
        <param name="type">dxl</param>
        <param name="ID">${dxl_id}</param>
        <param name="Operating Mode">${operating_mode}</param>  <!-- 3 = position, 5 = current-based position -->
        <!-- Servo position limits in raw ticks (2048 = 0 rad), 3 deg beyond the software limits -->
        <param name="Min Position Limit">285</param>
        <param name="Max Position Limit">2196</param>
        <!-- The XM430 reports Present PWM as a signed 16-bit value, but the model file lacks the sign -->
        <param name="[unit info]">Present PWM, 1.0, raw, signed, 0.0</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Present PWM"/>
        <state_interface name="Present Input Voltage"/>
        <state_interface name="Present Temperature"/>
        <state_interface name="Moving"/>
      </gpio>
    </xacro:unless>
  </ros2_control>

  </xacro:macro>

</robot>
